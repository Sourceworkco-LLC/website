# Contact form delivery. When RESEND_API_KEY is unset the form falls back to a
# mailto: compose window, so the site still works with no configuration at all.
RESEND_API_KEY=
# Where contact form submissions are delivered. Defaults to ryan@sourceworkco.com.
CONTACT_NOTIFY_EMAIL=ryan@sourceworkco.com
# Verified Resend sender. Defaults to Resend's onboarding sender for first deploys.
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Canonical site origin, used for metadata and sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://sourceworkco.com
